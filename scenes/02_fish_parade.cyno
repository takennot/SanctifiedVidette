object bunny 12 -0.8 -14 1.2 -30 0
object cat -14 1.2 -4 3.0 60 100
object monkey 13 0.7 -5 1.1 140 25
object teapot -10 -0.8 -17 0.025 0 12
object teapot 10 -0.8 -17 0.025 0 -12
