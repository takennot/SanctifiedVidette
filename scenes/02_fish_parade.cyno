# Scene 2
# Swim between oversized fish
scene Fish Parade
player1 -9 2.5 10 -60 -5
player2 9 2.5 10 -120 -5
goal 0 2.0 -18

# Two moving fish form the main route
object fishclown -4 0.6 -5 7.0 70 18
object fishclown 5 0.6 -11 8.0 -70 -14
object fishclown -2 1.8 -15 4.0 30 25

# Other creatures and props around the route
